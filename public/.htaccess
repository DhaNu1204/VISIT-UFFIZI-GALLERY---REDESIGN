# ========================================
# UFFIZI GALLERY - Apache Configuration
# For Hostinger Static Site Hosting
# ========================================

RewriteEngine On

# ========================================
# WWW TO NON-WWW REDIRECT (Optional)
# ========================================
RewriteCond %{HTTP_HOST} ^www\.visituffizi\.com [NC]
RewriteRule ^(.*)$ https://visituffizi.com/$1 [L,R=301]

# ========================================
# 301 REDIRECTS - OLD WORDPRESS URLs
# Using RedirectMatch to handle trailing slashes
# ========================================

# General Pages (handles with or without trailing slash)
RedirectMatch 301 ^/visit-uffizi-gallery/?$ /en
RedirectMatch 301 ^/uffizi-skip-the-line-tickets/?$ /en/tickets/skip-the-line
RedirectMatch 301 ^/uffizi-gallery-prices/?$ /en/tickets/prices
RedirectMatch 301 ^/uffizi-tours/?$ /en/tours
RedirectMatch 301 ^/uffizi-gallery-private-tour/?$ /en/tours/private-tour
RedirectMatch 301 ^/uffizi-gallery-guided-tour/?$ /en/tours/guided-tour
RedirectMatch 301 ^/uffizi-accademia-tour/?$ /en/tours/uffizi-accademia-tour
RedirectMatch 301 ^/uffizi-gallery-tickets/?$ /en/tickets
RedirectMatch 301 ^/vasari-corridor-tickets/?$ /en/vasari-corridor
RedirectMatch 301 ^/uffizi-gallery-opening-hours/?$ /en/uffizi-gallery-opening-hours
RedirectMatch 301 ^/how-to-get-to-the-uffizi-gallery/?$ /en/directions
RedirectMatch 301 ^/getting-to-the-uffizi-gallery/?$ /en/directions
RedirectMatch 301 ^/the-uffizi-gallery-door-3-importent-information/?$ /en/the-uffizi-gallery-door-3-importent-information
RedirectMatch 301 ^/uffizi-gallery-in-2-hours-what-to-see-and-where-to-look/?$ /en/uffizi-gallery-in-2-hours-what-to-see-and-where-to-look
RedirectMatch 301 ^/the-history-of-the-uffizi-gallery/?$ /en/history
RedirectMatch 301 ^/history-of-uffizi-gallery/?$ /en/history
RedirectMatch 301 ^/uffizi-gallery-artworks/?$ /en/artworks
RedirectMatch 301 ^/uffizi-artworks/?$ /en/artworks
RedirectMatch 301 ^/uffizi-gallery-artists/?$ /en/artists
RedirectMatch 301 ^/famous-renaissance-artists/?$ /en/artists
RedirectMatch 301 ^/plan-your-visit-to-uffizi-gallery/?$ /en/visitor-info
RedirectMatch 301 ^/visitor-info/?$ /en/visitor-info

# Artist Pages - English (handles with or without trailing slash)
RedirectMatch 301 ^/giotto/?$ /en/artists/giotto
RedirectMatch 301 ^/michelangelo/?$ /en/artists/michelangelo
RedirectMatch 301 ^/sandro-botticelli/?$ /en/artists/sandro-botticelli
RedirectMatch 301 ^/leonardo-da-vinci/?$ /en/artists/leonardo-da-vinci
RedirectMatch 301 ^/giorgio-vasari/?$ /en/artists/giorgio-vasari
RedirectMatch 301 ^/raffaello-sanzio/?$ /en/artists/raphael
RedirectMatch 301 ^/tiziano/?$ /en/artists/titian
RedirectMatch 301 ^/rembrandt/?$ /en/artists/rembrandt
RedirectMatch 301 ^/dante-alighieri/?$ /en/artists/dante-alighieri
RedirectMatch 301 ^/piero-della-francesca/?$ /en/artists/piero-della-francesca
RedirectMatch 301 ^/filippo-brunelleschi-biography-artwork/?$ /en/artists/filippo-brunelleschi
RedirectMatch 301 ^/caravaggio/?$ /en/artists/caravaggio

# Italian Pages (handles with or without trailing slash)
RedirectMatch 301 ^/it/visita-galleria-uffizi/?$ /it
RedirectMatch 301 ^/it/biglietti-salta-fila-uffizi/?$ /it/tickets/skip-the-line
RedirectMatch 301 ^/it/getting-to-the-uffizi-gallery/?$ /it/directions
RedirectMatch 301 ^/it/history-of-uffizi-gallery/?$ /it/history
RedirectMatch 301 ^/it/uffizi-artworks/?$ /it/artworks
RedirectMatch 301 ^/it/famous-renaissance-artists/?$ /it/artists
RedirectMatch 301 ^/it/plan-your-visit-to-uffizi-gallery/?$ /it/visitor-info

# Artist Pages - Italian (handles with or without trailing slash)
RedirectMatch 301 ^/it/giotto/?$ /it/artists/giotto
RedirectMatch 301 ^/it/michelangelo/?$ /it/artists/michelangelo
RedirectMatch 301 ^/it/sandro-botticelli/?$ /it/artists/sandro-botticelli
RedirectMatch 301 ^/it/leonardo-da-vinci/?$ /it/artists/leonardo-da-vinci
RedirectMatch 301 ^/it/giorgio-vasari/?$ /it/artists/giorgio-vasari
RedirectMatch 301 ^/it/raffaello-sanzio/?$ /it/artists/raphael
RedirectMatch 301 ^/it/tiziano/?$ /it/artists/titian
RedirectMatch 301 ^/it/rembrandt/?$ /it/artists/rembrandt
RedirectMatch 301 ^/it/dante-alighieri/?$ /it/artists/dante-alighieri
RedirectMatch 301 ^/it/piero-della-francesca/?$ /it/artists/piero-della-francesca
RedirectMatch 301 ^/it/filippo-brunelleschi-biography-artwork/?$ /it/artists/filippo-brunelleschi
RedirectMatch 301 ^/it/caravaggio/?$ /it/artists/caravaggio

# ========================================
# ROOT REDIRECT TO ENGLISH
# ========================================
RedirectMatch 301 ^/?$ /en

# ========================================
# SERVE STATIC FILES
# ========================================
DirectoryIndex index.html

# Serve .html files without extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# ========================================
# ERROR PAGES
# ========================================
ErrorDocument 404 /404.html

# ========================================
# PERFORMANCE - Caching
# ========================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ========================================
# COMPRESSION
# ========================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json
  AddOutputFilterByType DEFLATE application/javascript text/xml application/xml
</IfModule>

# ========================================
# SECURITY
# ========================================
Options -Indexes
AddDefaultCharset UTF-8

# Prevent clickjacking
Header set X-Frame-Options "SAMEORIGIN"

# Prevent MIME sniffing
Header set X-Content-Type-Options "nosniff"
